# Base URL of the BoardSense FastAPI backend (single source of truth for
# all frontend API calls; see src/services/api.js).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public Supabase project URL for Google authentication.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable anon key (never put a service-role key here).
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
