# Absolute path to Stockfish, or `stockfish` when it is available on PATH.
# Resolution priority: STOCKFISH_PATH, then /usr/games/stockfish
# (apt/Docker default), then `stockfish` on PATH.
STOCKFISH_PATH=stockfish

# Optional database URL (reserved for future persistence; unused today).
# DATABASE_URL=postgresql://user:password@host:5432/boardsense

# Comma-separated browser origins allowed to call the API.
# Add the Vercel frontend origin in production, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public Supabase project URL (no secrets here).
# Access tokens are verified against this project's JWKS document
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json, ES256). No JWT secret
# is required.
SUPABASE_URL=https://your-project.supabase.co
